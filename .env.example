# Copy this file to .env and fill in what you have.
# On Windows PowerShell:  $env:OPENROUTER_API_KEY="sk-or-..."  (per-session)
# Or use a tool like python-dotenv to load this file automatically.

# Cloud model via OpenRouter (required for cloud routing / fail-safe)
OPENROUTER_API_KEY=
CLOUD_MODEL=z-ai/glm-5.3-flash

# Local Ollama
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:8b

# Tools
OPENWEATHER_API_KEY=
NEWS_API_KEY=